{
  "name": "student",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
