rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !exists(/databases/$(database)/documents/account_deletions/$(uid));
    }
    match /students/{studentId}/scores/{scoreId} {
      allow read: if activeOwner(studentId);
      // Only the trusted grading service can write approved scores.
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
