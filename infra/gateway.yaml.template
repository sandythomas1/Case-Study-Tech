swagger: '2.0'
info:
  title: CaseStudy Tech Accounts
  version: '0.1.0'
schemes: [https]
host: accounts.endpoints.${PROJECT_ID}.cloud.goog
x-google-endpoints:
  - name: accounts.endpoints.${PROJECT_ID}.cloud.goog
    allowCors: true
produces: [application/json]
x-google-backend:
  address: ${ACCOUNTS_SERVICE_URL}
  jwt_audience: ${ACCOUNTS_SERVICE_URL}
  path_translation: APPEND_PATH_TO_ADDRESS
securityDefinitions:
  firebase:
    type: oauth2
    flow: implicit
    authorizationUrl: ''
    x-google-issuer: https://securetoken.google.com/${PROJECT_ID}
    x-google-jwks_uri: https://www.googleapis.com/service_accounts/v1/metadata/x509/securetoken@system.gserviceaccount.com
    x-google-audiences: ${PROJECT_ID}
security:
  - firebase: []
paths:
  /health:
    options:
      operationId: healthPreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    get:
      operationId: health
      security: []
      responses: { '200': { description: Healthy } }
  /v1/auth/google:
    options:
      operationId: googlePreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: googleSignIn
      security: []
      responses: { '200': { description: Authenticated }, '401': { description: Rejected } }
  /v1/auth/refresh:
    options:
      operationId: refreshPreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: refreshSession
      security: []
      responses: { '200': { description: Refreshed }, '401': { description: Rejected } }
  /v1/me:
    options:
      operationId: currentStudentPreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    get:
      operationId: currentStudent
      responses: { '200': { description: Verified student }, '401': { description: Rejected } }
  /v1/scores:
    options:
      operationId: scoresPreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    get:
      operationId: ownScores
      responses: { '200': { description: Own score records }, '401': { description: Rejected } }
  /v1/account/deletion:
    options:
      operationId: deletionPreflight
      security: []
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: requestDeletion
      responses: { '202': { description: Accepted }, '401': { description: Rejected } }
%{ if SESSION_SERVICE_URL != "" ~}
  # Session routes (AD-4 per-route backend). Placeholders until #31 fixes the
  # contract. The grading service has no route here (AD-3).
  /v1/sessions/health:
    get:
      operationId: sessionHealth
      security: []
      x-google-backend:
        address: ${SESSION_SERVICE_URL}/health
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: CONSTANT_ADDRESS
      responses: { '200': { description: Healthy } }
  /v1/sessions:
    options:
      operationId: sessionStartPreflight
      security: []
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: startSession
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
      responses: { '200': { description: Session started }, '401': { description: Rejected } }
  /v1/sessions/turns:
    options:
      operationId: sessionTurnPreflight
      security: []
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: sessionTurn
      # Transcription + persona inference + synthesis can exceed the 15s default.
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
        deadline: 30.0
      responses: { '200': { description: Persona reply and new signed state }, '401': { description: Rejected } }
  /v1/sessions/end:
    options:
      operationId: sessionEndPreflight
      security: []
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
      responses: { '200': { description: CORS preflight } }
    post:
      operationId: endSession
      # AD-3: waits for grading. Must exceed the session Cloud Run timeout (180s),
      # which exceeds grading (120s). See infra/session-grading/main.tf locals.
      x-google-backend:
        address: ${SESSION_SERVICE_URL}
        jwt_audience: ${SESSION_SERVICE_URL}
        path_translation: APPEND_PATH_TO_ADDRESS
        deadline: 190.0
      responses: { '200': { description: Report }, '401': { description: Rejected } }
%{ endif ~}
